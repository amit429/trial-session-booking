# Copy to .env (root) — read by the API, Prisma and the seed script.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trialbooking
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/trialbooking_test
PORT=4000
APP_BASE_URL=http://localhost:5173
# HMAC key for private booking manage links. Use 32+ random characters in production.
APP_SECRET=dev-only-secret-change-me-0123456789abcdef
ADMIN_EMAIL=admin@trialdesk.example
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Ops Admin
DEV_OUTBOX_ENABLED=true
PARENT_SESSION_DAYS=7
ADMIN_SESSION_HOURS=12
MIN_NOTICE_MINUTES=120
BOOKING_HORIZON_DAYS=14
SLOT_STEP_MINUTES=30
CLASS_DURATION_MINUTES=60
DEFAULT_MAX_DAILY_TRIALS=2
PARENT_HOURS_START=08:00
PARENT_HOURS_END=21:00
SUGGESTIONS_SAME_DAY=4
SUGGESTIONS_SAME_TIME=3
SUGGESTIONS_NEAREST=4
MEETING_BASE_URL=https://meet.trialdesk.example/trial
